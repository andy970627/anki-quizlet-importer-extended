{
  "manifest_version": 3,
  "version": "2.4.1.1",
  "default_locale": "en",
  "name": "Better Lyrics + 歌詞節奏模式（非官方 fork）",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://betterlyrics.org",
  "icons": {
    "16": "images/icons/icon-16.png",
    "48": "images/icons/icon-48.png",
    "512": "images/icons/icon-512.png"
  },
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "externally_connectable": {
    "matches": [
      "https://unison.betterlyrics.org/*",
      "https://unison.boidu.dev/*",
      "https://blrcunison.vercel.app/*"
    ]
  },
  "optional_permissions": [
    "downloads"
  ],
  "optional_host_permissions": [],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://blrcunison.vercel.app https://boidu.dev https://betterlyrics.org https://raw.githubusercontent.com https://placehold.co https://cdn.betterlyrics.org https://cdn.discordapp.com https://*.googleusercontent.com; connect-src https://unison.betterlyrics.org https://unison.boidu.dev https://raw.githubusercontent.com https://api.github.com https://themes.betterlyrics.org; frame-src https://themes.betterlyrics.org;"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "resources": [
        "_locales/*/messages.json",
        "css/blyrics/*.css",
        "css/ytmusic/*.css",
        "css/disablestylizedanimations.css",
        "css/themesong.css",
        "css/themes/*.css",
        "images/icons/shaders.png",
        "*.js.map",
        "pages/standalone-editor.html",
        "pages/marketplace.html",
        "pages/unison.html"
      ]
    },
    {
      "matches": [
        "https://unison.betterlyrics.org/*",
        "https://unison.boidu.dev/*",
        "https://blrcunison.vercel.app/*"
      ],
      "resources": [
        "pages/auth.html"
      ]
    }
  ],
  "chromium:background": {
    "service_worker": "src/options/background.ts",
    "type": "module"
  },
  "gecko:background": {
    "scripts": [
      "src/options/background.ts"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-lyrics-rhythm-fork@example.invalid",
      "strict_min_version": "128.0"
    },
    "gecko_android": {}
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/index.ts"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "public/earlyInject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "public/script.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/pageWorld.ts"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/options/options.html"
  },
  "version_name": "2.4.1 1"
}
